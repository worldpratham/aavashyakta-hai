{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "NEw project Avasyakta hai/dist",
  "functions": {
    "api/index.js": {
      "includeFiles": "Backend avashyakta hai/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
